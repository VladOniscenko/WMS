# StudioPlatform Environment Configuration

# JWT Secret - minimum 32 characters for HMAC SHA-256 signing
JWT_SECRET=development-only-secret-change-me-please-32chars

# Optional SMTP Configuration (leave empty to use Console/Redis logger in dev)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USERNAME=your-username
# SMTP_PASSWORD=your-password
# SMTP_FROM=noreply@studioplatform.com

# Optional S3 Storage Configuration (leave empty to use local filesystem storage)
# S3_BUCKET_NAME=my-studio-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_CDN_URL=https://cdn.example.com
