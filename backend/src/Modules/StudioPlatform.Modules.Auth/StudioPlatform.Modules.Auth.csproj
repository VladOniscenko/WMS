    <IsPackable>true</IsPackable>
    <PackageId>StudioPlatform.Modules.Auth</PackageId>
    <Version>1.0.0</Version>
    <Authors>StudioPlatform</Authors>
    <Description>Passwordless OTP authentication and JWT issuance.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\StudioPlatform.Shared\StudioPlatform.Shared.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
  </ItemGroup>

</Project>
